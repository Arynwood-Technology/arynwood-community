# Arynwood Grove settings. Community 0.3 names (COMMUNITY_*) are still read if present.

# Where the app listens. Keep 127.0.0.1 unless it sits behind an HTTPS reverse proxy.
GROVE_BIND=127.0.0.1
GROVE_PORT=8018
# On a server: the address members open. It makes invite links point there, trusts it as
# the page origin and host name, and marks sign-in cookies Secure over HTTPS.
# GROVE_PUBLIC_URL=https://grove.example.org
# Optional: another page allowed to use this service (e.g. an owner workspace on this machine).
# GROVE_ORIGIN=http://127.0.0.1:5180
# Where the database lives (default: data/).
# GROVE_DATA_DIR=
# Set by the server installer so only the installer can create the host account.
# GROVE_SETUP_CODE=

# Host mailbox for the Mail page (optional).
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
MAIL_IMAP_USER=
MAIL_IMAP_PASS=
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
MAIL_FROM=
NKN_IDENTIFIER=arynwood-hub
SOCKS5_PROXY=

# Optional Grove branding. A name enables the branded welcome page.
# GROVE_BRAND_NAME=
# GROVE_BRAND_TAGLINE=
# GROVE_BRAND_ACCENT=#4fd1ab
# GROVE_BRAND_SITE_URL=
# GROVE_BRAND_SITE_LABEL=Website
# GROVE_BRAND_SHOP_URL=
# GROVE_BRAND_SHOP_LABEL=Shop
# GROVE_BRAND_LOGO=

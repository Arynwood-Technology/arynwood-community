COMMUNITY_PORT=8018
# For a hosted install, set the public origin and host names, and serve over HTTPS:
# COMMUNITY_ORIGIN=https://community.example.org
# COMMUNITY_HOSTS=community.example.org
# COMMUNITY_SECURE_COOKIE=1

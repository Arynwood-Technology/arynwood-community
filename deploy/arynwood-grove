#!/usr/bin/env bash
# Manage the Arynwood Groves on a server. Installed by deploy/install.sh as /usr/local/bin/arynwood-grove.
# The server's own Grove needs no name; the others (install.sh --name) are chosen with --grove NAME.
set -euo pipefail
# Files it writes for nginx must stay readable under a strict umask; private ones set their own mode.
umask 022
PREFIX=/opt/arynwood-grove
NAME_RE='^[a-z][a-z0-9-]{0,22}[a-z0-9]$'

# The paths and units of one Grove: grove_paths NAME, or grove_paths "" for the server's own.
grove_paths() {
  if [[ -n $1 ]]; then
    NAME=$1 DATA=/var/lib/arynwood-groves/$1 ENV_FILE=/etc/arynwood-groves/$1.env SERVICE=arynwood-grove@$1
    CURRENT=$PREFIX/groves/$1 RUN_USER=grove-$1 SITE_NAME=arynwood-grove-$1 ME="arynwood-grove --grove $1"
  else
    NAME="" DATA=/var/lib/arynwood-grove ENV_FILE=/etc/arynwood-grove/grove.env SERVICE=arynwood-grove
    CURRENT=$PREFIX/current RUN_USER=grove SITE_NAME=arynwood-grove ME="arynwood-grove"
  fi
  SITE=/etc/nginx/sites-available/$SITE_NAME PREVIOUS_SITE=/etc/nginx/sites-available/$SITE_NAME-previous
}
# Every Grove on this server, one per line; the server's own is the empty line.
groves() {
  [[ -f /etc/arynwood-grove/grove.env ]] && echo ""
  for file in /etc/arynwood-groves/*.env; do [[ -f $file ]] && basename "$file" .env; done
  return 0
}
NAME=""
case ${1:-} in
  --grove|-g) NAME=${2:-}; shift 2 || true ;;
  --grove=*) NAME=${1#--grove=}; shift ;;
esac
if [[ -n $NAME ]] && ! [[ $NAME =~ $NAME_RE && -f /etc/arynwood-groves/$NAME.env ]]; then
  echo "There is no Grove named \"$NAME\" on this server. See: sudo arynwood-grove list" >&2; exit 1
fi
grove_paths "$NAME"

env_value() { sed -n "s/^$1=//p" "$ENV_FILE" 2>/dev/null | tail -n1; }
need_root() { [[ $EUID -eq 0 ]] || { echo "Run with sudo: sudo $ME $*" >&2; exit 1; }; }
need_grove() {
  [[ -f $ENV_FILE ]] && return 0
  echo "This server has no Grove without a name. Choose one with --grove NAME:" >&2
  groves | sed 's/^/  /' >&2; exit 1
}
wait_healthy() {
  local port; port=$(env_value GROVE_PORT)
  for _ in $(seq 1 30); do curl -fsS -m 2 "http://127.0.0.1:${port:-8018}/api/health" >/dev/null 2>&1 && { echo "The Grove is running."; return 0; }; sleep 1; done
  echo "The Grove did not answer. See: sudo $ME logs" >&2; return 1
}
admin() { (cd "$CURRENT" && runuser -u "$RUN_USER" -- env GROVE_ENV_FILE="$ENV_FILE" .venv/bin/python deploy/grove_admin.py "$@"); }
newest_release() { ls -1 "$PREFIX/releases" 2>/dev/null | grep -vE '\.(new|old)$' | sort -V | tail -n1; }

# Off-server copies of every Grove, made with restic. The settings are server-wide and root's alone.
OFFSITE_ENV=/etc/arynwood-grove-offsite.env OFFSITE_STATE=/var/lib/arynwood-grove-offsite
# restic with the repository, its password and any provider keys, read literally from the settings.
offsite_restic() {
  local vars=() line
  while IFS= read -r line; do [[ $line =~ ^[A-Z][A-Z0-9_]*= ]] && vars+=("$line"); done <"$OFFSITE_ENV"
  env "${vars[@]}" restic --cache-dir "$OFFSITE_STATE/cache" "$@"
}
# The repository without any password written into it.
offsite_repo() { sed -n 's/^RESTIC_REPOSITORY=//p' "$OFFSITE_ENV" | tail -n1 | sed -E 's#//[^/@]*@#//…@#'; }
offsite_ready() { grep -q '^RESTIC_REPOSITORY=.' "$OFFSITE_ENV" 2>/dev/null; }
need_offsite() { offsite_ready || { echo "Off-server copies are not set up. See: sudo arynwood-grove offsite help" >&2; exit 1; }; }
# A consistent copy of the live database, made as the Grove's own user. It is kept apart from the
# daily copies, so it doesn't shorten their 14 days.
offsite_db_copy() {
  local db; db=$(admin path </dev/null) || return 1
  [[ -f $db ]] || return 0
  (cd / && runuser -u "$RUN_USER" -- python3 -I -c 'import os, sqlite3, sys
folder = os.path.join(os.path.dirname(sys.argv[1]), "backups")
os.makedirs(folder, mode=0o700, exist_ok=True)
target = os.path.join(folder, "offsite.sqlite3")
live, copy = sqlite3.connect(sys.argv[1]), sqlite3.connect(target + ".tmp")
live.backup(copy); copy.close(); live.close()
os.chmod(target + ".tmp", 0o600); os.replace(target + ".tmp", target)' "$db")
}
offsite_run() {
  need_offsite
  local paths=() grove path failed=0
  while read -r grove; do
    grove_paths "$grove"
    offsite_db_copy || { echo "Could not copy the database of ${grove:-the Grove without a name}." >&2; failed=1; }
    for path in "$DATA" "$ENV_FILE" "$SITE"; do [[ -e $path ]] && paths+=("$path"); done
  done < <(groves)
  [[ ${#paths[@]} -gt 0 ]] || { echo "There is no Grove on this server to copy." >&2; return 1; }
  install -d -m 0700 "$OFFSITE_STATE"
  offsite_restic unlock >/dev/null 2>&1 || true
  # The live database is left out: backups/offsite.sqlite3 is its consistent copy.
  offsite_restic backup --quiet --tag arynwood-grove --exclude grove.sqlite3 --exclude 'grove.sqlite3-*' \
    --exclude community.sqlite3 --exclude 'community.sqlite3-*' --exclude files/tmp --exclude files/uploads "${paths[@]}" \
    || { echo "The off-server copy failed." >&2; return 1; }
  date -Is >"$OFFSITE_STATE/last"
  # Grouped by server, so adding a Grove doesn't start a separate history that is never thinned.
  offsite_restic forget --quiet --tag arynwood-grove --group-by host,tags --keep-daily 14 --keep-weekly 8 --keep-monthly 12 --prune >/dev/null \
    || { echo "The copy was made, but older copies could not be thinned out." >&2; failed=1; }
  echo "Copied ${#paths[@]} paths off the server: $(offsite_repo)"
  return $failed
}
offsite_on() {
  systemctl enable -q --now arynwood-grove-offsite.timer
  echo "Making the first copy now. Further copies are made every night."
  offsite_run
}

usage() {
  cat <<'USAGE'
Usage: sudo arynwood-grove [--grove NAME] <command>

Without --grove, commands act on the server's own Grove; with it, on the Grove of that name.

  list                 Every Grove on this server: state, version, port, data, address
  create NAME --domain grove.example.com [--email ADDRESS] [--no-https] [--port N]
                       Add a Grove to this server, using the newest release here
  status               Is it running, which version, where, last backup, certificate
  setup-link           The link that creates the host account (until it exists)
  invite-help          How to invite people
  recovery-code EMAIL  A 15-minute password reset code for someone who forgot theirs
  backup [--all]       Copy the database now (a daily copy is automatic; 14 are kept)
  restore FILE         Put a backup back (the current data is backed up first)
  offsite setup REPOSITORY [--existing]
                       Copy every Grove off this server each night, encrypted, with restic: to an
                       SFTP server (a Hetzner Storage Box), S3, B2 and others. See offsite help
  offsite status | list | run | check | on | off
  offsite restore [SNAPSHOT]
                       Put this Grove's data back from an off-server copy (by default the latest)
  update [--version X | --from FILE] [--all [--canary NAME]]
                       Install the latest release, keeping all data and settings. With --all,
                       every Grove: the first (or the canary) alone, and the rest only if it works
  rollback             Go back to the previous release
  logs                 The service's recent log
  restart              Restart the service
  set-domain NAME [--email ADDRESS]
                       Move the Grove to your own domain (the host can also do this in
                       Settings → Your Grove's address). Point the domain's A record here first.
USAGE
}

DOMAIN_RE='^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$'
EMAIL_RE='^[A-Za-z0-9._%+-]{1,64}@[A-Za-z0-9.-]{1,190}\.[A-Za-z]{2,24}$'

# Publishes the Grove at a new domain: nginx, a reachability check, a certificate (unless the
# Grove runs without HTTPS), the new address in the settings, and a redirect from the old one.
# Any failure before the switch puts the previous nginx site back.
set_domain() {
  local domain=$1 email=${2:-} url old scheme port probe answer
  [[ ${#domain} -le 253 && $domain =~ $DOMAIN_RE ]] || { echo "\"$domain\" is not a web address like grove.example.com." >&2; return 1; }
  [[ -z $email || $email =~ $EMAIL_RE ]] || { echo "\"$email\" is not an email address." >&2; return 1; }
  url=$(env_value GROVE_PUBLIC_URL); old=${url#*://}; old=${old%%/*}; old=${old%%:*}
  scheme=${url%%://*}; [[ $scheme == http ]] || scheme=https
  port=$(env_value GROVE_PORT); port=${port:-8018}
  [[ $domain != "$old" ]] || { echo "The Grove already uses $domain."; return 0; }
  [[ -f $SITE ]] || { echo "No nginx site at $SITE; this Grove was not set up by the installer." >&2; return 1; }
  cp -p "$SITE" "$SITE.before-$domain"
  restore() { mv "$SITE.before-$domain" "$SITE"; nginx -t -q 2>/dev/null && systemctl reload nginx; }
  sed -e "s/@DOMAIN@/$domain/g" -e "s/@PORT@/$port/g" "$CURRENT/deploy/nginx-grove.conf" >"$SITE"
  nginx -t -q 2>/dev/null || { restore; echo "nginx rejected the new site." >&2; return 1; }
  systemctl reload nginx
  install -d -m 0755 /var/www/acme/.well-known/acme-challenge
  probe=$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')
  echo "$probe" >"/var/www/acme/.well-known/acme-challenge/grove-$probe"
  # nginx finishes reloading a moment after the command returns, so try for a few seconds.
  for _ in $(seq 1 10); do
    answer=$(curl -fsS -m 10 "http://$domain/.well-known/acme-challenge/grove-$probe" 2>/dev/null || true)
    [[ $answer == "$probe" ]] && break; sleep 1
  done
  rm -f "/var/www/acme/.well-known/acme-challenge/grove-$probe"
  if [[ $answer != "$probe" ]]; then
    restore
    echo "http://$domain does not reach this server yet. Check its A record (it can take a few minutes to update) and that ports 80 and 443 are open." >&2
    return 1
  fi
  if [[ $scheme == https ]]; then
    local account=(--register-unsafely-without-email); [[ -n $email ]] && account=(-m "$email")
    certbot --nginx -d "$domain" --non-interactive --agree-tos --redirect "${account[@]}" -q \
      || { restore; echo "Let's Encrypt could not issue a certificate for $domain." >&2; return 1; }
  fi
  rm -f "$SITE.before-$domain"
  # People who saved the old address are sent to the new one.
  if [[ -n $old ]]; then
    {
      echo "# Earlier address of this Grove, forwarding to the current one."
      echo "server { listen 80; listen [::]:80; server_name $old; return 301 $scheme://$domain\$request_uri; }"
      if [[ -f /etc/letsencrypt/live/$old/fullchain.pem ]]; then
        echo "server { listen 443 ssl; listen [::]:443 ssl; server_name $old;"
        echo "  ssl_certificate /etc/letsencrypt/live/$old/fullchain.pem; ssl_certificate_key /etc/letsencrypt/live/$old/privkey.pem;"
        echo "  return 301 $scheme://$domain\$request_uri; }"
      fi
    } >"$PREVIOUS_SITE"
    ln -sfn "$PREVIOUS_SITE" "/etc/nginx/sites-enabled/$SITE_NAME-previous"
    nginx -t -q 2>/dev/null && systemctl reload nginx || { rm -f "/etc/nginx/sites-enabled/$SITE_NAME-previous"; systemctl reload nginx; }
  fi
  sed -i "s#^GROVE_PUBLIC_URL=.*#GROVE_PUBLIC_URL=$scheme://$domain#" "$ENV_FILE"
  systemctl restart "$SERVICE"
  wait_healthy >/dev/null || { echo "The Grove did not restart. See: sudo $ME logs" >&2; return 1; }
  echo "The Grove is now at $scheme://$domain"
}

command=${1:-help}; shift || true
case $command in
  list)
    need_root list
    printf '%-24s %-10s %-9s %-6s %-6s %s\n' GROVE STATE VERSION PORT DATA ADDRESS
    while read -r grove; do
      grove_paths "$grove"
      printf '%-24s %-10s %-9s %-6s %-6s %s\n' "${grove:-(no name)}" "$(systemctl is-active "$SERVICE" 2>/dev/null || true)" \
        "$(basename "$(readlink -f "$CURRENT")")" "$(env_value GROVE_PORT)" "$(du -sh "$DATA" 2>/dev/null | cut -f1)" "$(env_value GROVE_PUBLIC_URL)"
    done < <(groves)
    ;;
  create)
    need_root create
    name=${1:-}; shift || true
    [[ $name =~ $NAME_RE ]] || { echo "Usage: sudo arynwood-grove create NAME --domain grove.example.com [--email you@example.com]" >&2; echo "NAME: 2 to 24 lowercase letters, digits and dashes, starting with a letter." >&2; exit 1; }
    [[ ! -f /etc/arynwood-groves/$name.env ]] || { echo "There is already a Grove named \"$name\". See: sudo arynwood-grove list" >&2; exit 1; }
    newest=$(newest_release)
    [[ -n $newest ]] || { echo "No release on this server yet. Install the first Grove with install.sh." >&2; exit 1; }
    # The newest release here, unless a release file or version is given.
    release=(--from "$PREFIX/releases/$newest")
    for arg in "$@"; do [[ $arg == --from || $arg == --version ]] && release=(); done
    bash "$PREFIX/releases/$newest/deploy/install.sh" --name "$name" "${release[@]}" "$@"
    ;;
  status)
    need_root status; need_grove
    url=$(env_value GROVE_PUBLIC_URL); domain=${url#*://}; domain=${domain%%/*}
    [[ -z $NAME ]] || printf 'Grove:     %s\n' "$NAME"
    printf 'Service:   %s\n' "$(systemctl is-active "$SERVICE" 2>/dev/null || true)"
    printf 'Version:   %s\n' "$(basename "$(readlink -f "$CURRENT")")"
    printf 'Address:   %s\n' "${url:-not set}"
    db=$(admin path); printf 'Data:      %s (%s)\n' "$db" "$(du -h "$db" 2>/dev/null | cut -f1 || echo none yet)"
    last=$(ls -1t "$(dirname "$db")/backups/"grove-*.sqlite3 2>/dev/null | head -n1 || true)
    printf 'Backup:    %s\n' "${last:-none yet}"
    if offsite_ready; then printf 'Off-site:  last copy %s\n' "$(cat "$OFFSITE_STATE/last" 2>/dev/null || echo 'none yet')"
    else printf 'Off-site:  not set up (sudo arynwood-grove offsite help)\n'; fi
    cert=/etc/letsencrypt/live/$domain/cert.pem
    if [[ -f $cert ]]; then printf 'HTTPS:     certificate valid until %s\n' "$(openssl x509 -enddate -noout -in "$cert" | cut -d= -f2)"
    else printf 'HTTPS:     no certificate\n'; fi
    ;;
  setup-link) need_root setup-link; need_grove; admin setup-link ;;
  invite-help)
    echo 'Sign in, choose a space, and click "Invite members".'
    echo '  - An invitation link admits one person and expires after seven days. Send it privately.'
    echo '  - A public invite link lets anyone who has it join. Post it where your friends will see it,'
    echo '    and turn it off in the same place when you are done.'
    ;;
  recovery-code)
    need_root recovery-code; need_grove
    [[ -n ${1:-} ]] || { echo "Usage: sudo $ME recovery-code person@example.com" >&2; exit 1; }
    echo "Give this code to the person privately. They enter it under \"Forgot password?\" within 15 minutes:"
    admin recovery-code "$1"
    ;;
  backup)
    need_root backup
    if [[ ${1:-} == --all ]]; then
      failed=0
      while read -r grove; do
        grove_paths "$grove"
        printf '%s: ' "${grove:-(no name)}"; admin backup </dev/null || failed=1
      done < <(groves)
      exit $failed
    fi
    need_grove; admin backup
    ;;
  restore)
    need_root restore; need_grove
    file=${1:-}; [[ -f $file ]] || { echo "Usage: sudo $ME restore $DATA/backups/grove-….sqlite3" >&2; exit 1; }
    db=$(admin path)
    echo "Saving the current data first: $(admin backup)"
    systemctl stop "$SERVICE"
    install -m 0600 -o "$RUN_USER" -g "$RUN_USER" "$file" "$db"
    rm -f "$db-wal" "$db-shm"
    systemctl start "$SERVICE"
    echo "Restored $file"
    wait_healthy
    ;;
  update)
    need_root update
    from="" version=latest all=0 canary=""
    while [[ $# -gt 0 ]]; do
      case $1 in
        --from) from=${2:-}; shift 2 ;; --version) version=${2#v}; shift 2 ;;
        --all) all=1; shift ;; --canary) canary=${2:-}; all=1; shift 2 ;;
        *) echo "Unknown option: $1" >&2; exit 1 ;;
      esac
    done
    [[ $all == 1 ]] || need_grove
    [[ -z $canary || -f /etc/arynwood-groves/$canary.env ]] || { echo "There is no Grove named \"$canary\"." >&2; exit 1; }
    tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
    if [[ -z $from ]]; then
      repo=https://github.com/Arynwood-Technology/arynwood-community/releases
      if [[ $version == latest ]]; then base=${GROVE_RELEASE_BASE:-$repo/latest/download}; file=arynwood-grove.tar.gz
      else base=${GROVE_RELEASE_BASE:-$repo/download/v$version}; file=arynwood-grove-$version.tar.gz; fi
      echo "Downloading $base/$file"
      curl -fsSL --retry 3 -o "$tmp/$file" "$base/$file" && curl -fsSL --retry 3 -o "$tmp/$file.sha256" "$base/$file.sha256" \
        || { echo "Could not download the release." >&2; exit 1; }
      (cd "$tmp" && echo "$(cut -d' ' -f1 "$file.sha256")  $file" | sha256sum -c --quiet) \
        || { echo "The download is damaged (checksum mismatch). Nothing was changed." >&2; exit 1; }
      from=$tmp/$file
    fi
    # Run the new release's own installer, so an update can also fix the updater.
    mkdir "$tmp/new"; tar -xzf "$from" -C "$tmp/new" --strip-components=1 --wildcards '*/deploy/install.sh' \
      || { echo "$from is not a Grove release." >&2; exit 1; }
    if [[ $all == 0 ]]; then bash "$tmp/new/deploy/install.sh" --update --yes --from "$from" ${NAME:+--name "$NAME"}; exit; fi
    # One Grove first; the rest only once it runs the new release.
    if [[ -n $canary ]]; then mapfile -t list < <(echo "$canary"; groves | grep -vx -- "$canary")
    else mapfile -t list < <(groves); fi
    updated=() failed=()
    for grove in "${list[@]}"; do
      echo "== ${grove:-(no name)}"
      if bash "$tmp/new/deploy/install.sh" --update --yes --from "$from" ${grove:+--name "$grove"}; then updated+=("${grove:-(no name)}")
      else
        failed+=("${grove:-(no name)}")
        if [[ ${#updated[@]} == 0 && ${#failed[@]} == 1 ]]; then
          echo "The first Grove did not take the update and is back on its previous release. The others were not touched." >&2; exit 1
        fi
      fi
    done
    echo "Updated: ${updated[*]:-none}"
    [[ ${#failed[@]} == 0 ]] || { echo "Not updated (each is back on its previous release): ${failed[*]}" >&2; exit 1; }
    ;;
  rollback)
    need_root rollback; need_grove
    # The newest release older than the one running.
    now=$(basename "$(readlink -f "$CURRENT")")
    previous=$( (ls -1 "$PREFIX/releases"; echo "$now") | grep -vE '\.(new|old)$' | sort -uV | grep -B1 -x "$now" | grep -vx "$now" || true)
    previous=${previous:+$PREFIX/releases/$previous}
    [[ -n $previous ]] || { echo "There is no earlier release to go back to." >&2; exit 1; }
    echo "Backing up first: $(admin backup)"
    ln -sfn "$previous" "$CURRENT.new" && mv -T "$CURRENT.new" "$CURRENT"
    systemctl restart "$SERVICE"
    echo "Now running $(basename "$previous")."
    wait_healthy
    ;;
  offsite)
    need_root offsite
    action=${1:-status}; shift || true
    case $action in
      setup)
        repo="" existing=0
        while [[ $# -gt 0 ]]; do
          case $1 in --existing) existing=1; shift ;; -*) echo "Unknown option: $1" >&2; exit 1 ;; *) repo=$1; shift ;; esac
        done
        [[ -n $repo && $repo != *$'\n'* ]] || { echo "Usage: sudo arynwood-grove offsite setup REPOSITORY [--existing]. See: sudo arynwood-grove offsite help" >&2; exit 1; }
        packages=(); command -v restic >/dev/null || packages+=(restic)
        [[ $repo != sftp:* ]] || command -v ssh >/dev/null || packages+=(openssh-client)
        if [[ ${#packages[@]} -gt 0 ]]; then
          echo "Installing ${packages[*]}"
          DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "${packages[@]}" >/dev/null 2>&1 \
            || { echo "Could not install ${packages[*]}. Try: sudo apt-get update" >&2; exit 1; }
        fi
        install -d -m 0700 "$OFFSITE_STATE"
        password="" new_password=0
        [[ -f $OFFSITE_ENV ]] && password=$(sed -n 's/^RESTIC_PASSWORD=//p' "$OFFSITE_ENV" | tail -n1)
        # Copies made elsewhere: their password, from the settings file or typed in.
        if [[ $existing == 1 && -z $password ]]; then
          ( : </dev/tty ) 2>/dev/null || { echo "Put the copies' password in $OFFSITE_ENV as RESTIC_PASSWORD=…, or run this in a terminal to type it." >&2; exit 1; }
          read -r -s -p "Password of the existing copies: " password </dev/tty; echo
        fi
        [[ -n $password ]] || { password=$(od -An -N24 -tx1 /dev/urandom | tr -d ' \n'); new_password=1; }
        # Provider keys already in the file (for S3, B2 and the like) are kept.
        settings=$(mktemp "$OFFSITE_ENV.XXXXXX")
        {
          echo "# Off-server copies of every Grove (restic). Keep RESTIC_PASSWORD somewhere safe as well:"
          echo "# without it nobody, you included, can read the copies."
          echo "RESTIC_REPOSITORY=$repo"
          echo "RESTIC_PASSWORD=$password"
          [[ -f $OFFSITE_ENV ]] && grep -vE '^(RESTIC_REPOSITORY|RESTIC_PASSWORD)=|^# (Off-server copies of every Grove|without it nobody)' "$OFFSITE_ENV" || true
        } >"$settings"
        before=""; [[ -f $OFFSITE_ENV ]] && { before=$(mktemp "$OFFSITE_ENV.XXXXXX"); cp -p "$OFFSITE_ENV" "$before"; }
        mv "$settings" "$OFFSITE_ENV"
        put_back() { if [[ -n $before ]]; then mv "$before" "$OFFSITE_ENV"; else rm -f "$OFFSITE_ENV"; fi; }
        if offsite_restic cat config >/dev/null 2>&1; then echo "Connected to the copies at $(offsite_repo)."
        elif [[ $existing == 1 ]]; then
          put_back; echo "Could not open $repo with that password. (A RESTIC_PASSWORD= line in $OFFSITE_ENV is used before asking.)" >&2; exit 1
        elif ! output=$(offsite_restic init 2>&1); then
          put_back
          echo "Could not create a repository at $repo:" >&2; tail -n3 <<<"$output" >&2
          echo "If it already holds copies from another server, add --existing and enter their password." >&2; exit 1
        else echo "Created a repository at $(offsite_repo)."
        fi
        [[ -z $before ]] || rm -f "$before"
        if [[ $existing == 1 ]]; then
          # A new server: restore first, or the empty Groves become the latest copy.
          echo "Restore each Grove with: sudo arynwood-grove [--grove NAME] offsite restore"
          echo "Then start the nightly copies: sudo arynwood-grove offsite on"
          exit 0
        fi
        offsite_on || exit 1
        if [[ $new_password == 1 ]]; then
          echo
          echo "Save this password in your password manager now. Without it nobody, you included, can read the copies:"
          echo "  $password"
          echo "(It is also in $OFFSITE_ENV, which is lost with this server.)"
        fi
        ;;
      on) need_offsite; offsite_on ;;
      off)
        systemctl disable -q --now arynwood-grove-offsite.timer 2>/dev/null || true
        echo "Nightly off-server copies are off. The copies already made and the settings are kept; turn them on again with: sudo arynwood-grove offsite on"
        ;;
      run) offsite_run ;;
      status)
        offsite_ready || { echo "Off-server copies are not set up. See: sudo arynwood-grove offsite help"; exit 0; }
        last=$(cat "$OFFSITE_STATE/last" 2>/dev/null || true)
        printf 'Repository:  %s\n' "$(offsite_repo)"
        printf 'Nightly:     %s\n' "$(systemctl is-enabled arynwood-grove-offsite.timer 2>/dev/null | sed 's/^enabled$/on/; s/^disabled$/off/')"
        printf 'Last copy:   %s\n' "${last:-none yet}"
        if [[ -n $last ]] && (( $(date +%s) - $(date -d "$last" +%s) > 2 * 86400 )); then
          echo "The last copy is more than two days old. See: sudo journalctl -u arynwood-grove-offsite -n 50" >&2
        fi
        ;;
      list) need_offsite; offsite_restic snapshots --tag arynwood-grove --compact ;;
      check) need_offsite; offsite_restic check ;;
      restore)
        need_grove; need_offsite
        snapshot=${1:-latest}
        [[ $snapshot =~ ^(latest|[0-9a-f]{8,64})$ ]] || { echo "Usage: sudo $ME offsite restore [SNAPSHOT]. See: sudo arynwood-grove offsite list" >&2; exit 1; }
        stage=$(mktemp -d /root/grove-restore.XXXXXX); trap 'rm -rf "$stage"' EXIT
        echo "Fetching this Grove's data from copy $snapshot"
        offsite_restic restore "$snapshot" --target "$stage" --include "$DATA" --include "$ENV_FILE" >/dev/null \
          || { echo "Could not fetch copy $snapshot. See: sudo arynwood-grove offsite list" >&2; exit 1; }
        [[ -f $stage$DATA/backups/offsite.sqlite3 ]] || { echo "Copy $snapshot holds no data for this Grove." >&2; exit 1; }
        db=$(admin path); stamp=$(date +%Y%m%d-%H%M%S) restored=0
        echo "Saving the current data first: $(admin backup)"
        # Until the restored Grove answers, any failure puts its data from before back.
        trap 'if [[ $restored == 0 && -d $DATA.before-restore-$stamp ]]; then
            systemctl stop "$SERVICE"; rm -rf "$DATA"; mv "$DATA.before-restore-$stamp" "$DATA"; systemctl start "$SERVICE"
            wait_healthy >/dev/null 2>&1 || true
            echo "The restore did not finish, so the Grove has the data it had before." >&2
          fi; rm -rf "$stage"' EXIT
        systemctl stop "$SERVICE"
        mv "$DATA" "$DATA.before-restore-$stamp"
        mv "$stage$DATA" "$DATA"
        install -m 0600 "$DATA/backups/offsite.sqlite3" "$db"
        # A domain move the old server had pending is not repeated here.
        rm -f "$DATA"/requests/*
        chown -R "$RUN_USER:$RUN_USER" "$DATA"; chmod 0750 "$DATA"
        [[ -f $stage$ENV_FILE ]] && install -m 0600 "$stage$ENV_FILE" "$ENV_FILE.from-copy"
        systemctl start "$SERVICE"
        wait_healthy
        restored=1
        echo "Restored from copy $snapshot. The data from before is in $DATA.before-restore-$stamp: delete it once the Grove looks right."
        if [[ -f $ENV_FILE.from-copy ]] && ! cmp -s "$ENV_FILE" "$ENV_FILE.from-copy"; then
          echo "The copy's settings differ from this server's. They are in $ENV_FILE.from-copy. Compare them:"
          echo "  sudo diff $ENV_FILE $ENV_FILE.from-copy"
          echo "Copy across what you need, but keep this server's GROVE_PORT and GROVE_PUBLIC_URL. Then run: sudo $ME restart"
        else rm -f "$ENV_FILE.from-copy"; fi
        ;;
      help|-h|--help)
        cat <<'HELP'
Off-server copies: every Grove on this server, copied each night with restic, encrypted, and
deduplicated so each copy only adds what changed. 14 daily, 8 weekly and 12 monthly copies are kept.
Each copy holds the database, everyone's files, the settings and the nginx site.

  sudo arynwood-grove offsite setup REPOSITORY
      Creates the repository and a password, makes the first copy and turns on the nightly ones.
      Save the password it shows: without it nobody can read the copies.
      REPOSITORY is anything restic accepts, for example:
        sftp://u123456@u123456.your-storagebox.de:23/grove     a Hetzner Storage Box
        sftp:backup@backup.example.com:/srv/grove              any SFTP server
        s3:https://s3.eu-central-1.amazonaws.com/bucket/grove  S3 (also B2's and R2's S3 address)
      For SFTP, root must be able to log in with a key: create one with sudo ssh-keygen -t ed25519,
      add /root/.ssh/id_ed25519.pub to the backup server, and connect once with sudo sftp to accept
      its host key. For S3, first put AWS_ACCESS_KEY_ID= and AWS_SECRET_ACCESS_KEY= lines in
      /etc/arynwood-grove-offsite.env (mode 0600).
  sudo arynwood-grove offsite setup REPOSITORY --existing
      On a new server: connects to copies made elsewhere. It asks for their password, unless the
      settings file already has it. Install each Grove under the same name first, restore them, then
      turn on the nightly copies with offsite on.
  sudo arynwood-grove offsite status | list | run | check | on | off
  sudo arynwood-grove [--grove NAME] offsite restore [SNAPSHOT]
      Puts a Grove's data back from a copy (by default the latest; offsite list shows them all).
      The data it had is kept in a folder beside it.
HELP
        ;;
      *) echo "Unknown offsite command: $action. See: sudo arynwood-grove offsite help" >&2; exit 1 ;;
    esac
    ;;
  logs) need_root logs; need_grove; journalctl -u "$SERVICE" -n "${1:-100}" --no-pager ;;
  restart) need_root restart; need_grove; systemctl restart "$SERVICE"; wait_healthy ;;
  set-domain)
    need_root set-domain; need_grove
    domain=${1:-}; shift || true; email=""
    [[ ${1:-} == --email ]] && email=${2:-}
    [[ -n $domain ]] || { echo "Usage: sudo $ME set-domain grove.example.com [--email you@example.com]" >&2; exit 1; }
    set_domain "${domain,,}" "$email"
    ;;
  apply-domain-request)
    # Started by arynwood-grove-domain.path when the host asks in Settings. The request was
    # written by the service, so it is read as data and validated again here.
    need_root apply-domain-request; need_grove
    request=$DATA/requests/domain.json result=$DATA/requests/domain.result.json
    [[ -f $request ]] || exit 0
    fields=$(python3 -I -c 'import json,sys
d=json.load(open(sys.argv[1])) if __import__("os").path.getsize(sys.argv[1])<4096 else {}
print(str(d.get("domain","")).replace("\n"," ")); print(str(d.get("email","")).replace("\n"," "))' "$request" 2>/dev/null || printf '\n\n')
    rm -f "$request"
    domain=$(sed -n 1p <<<"$fields"); email=$(sed -n 2p <<<"$fields")
    if output=$(set_domain "$domain" "$email" 2>&1); then status=done; else status=failed; fi
    python3 -I -c 'import json,sys,time; json.dump({"status":sys.argv[1],"domain":sys.argv[2],"message":sys.argv[3].strip().splitlines()[-1] if sys.argv[3].strip() else "","finished":time.time()},open(sys.argv[4],"w"))' \
      "$status" "$domain" "$output" "$result.tmp"
    chown "$RUN_USER:$RUN_USER" "$result.tmp"; chmod 0640 "$result.tmp"; mv "$result.tmp" "$result"
    echo "$output"
    ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 1 ;;
esac

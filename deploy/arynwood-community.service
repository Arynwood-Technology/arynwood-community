[Unit]
Description=Arynwood Community
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=arynwood
Group=arynwood
WorkingDirectory=/opt/arynwood-community
EnvironmentFile=/opt/arynwood-community/.env
ExecStart=/opt/arynwood-community/.venv/bin/python -m uvicorn backend.api:app --host 127.0.0.1 --port 8018
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/arynwood-community/data /opt/arynwood-community/nkn

[Install]
WantedBy=multi-user.target
